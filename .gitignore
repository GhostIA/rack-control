# ---------------------------------------------------------------------------
# Secrets: never commit. Commit only *.example / placeholder files.
# Real values come from 1Password at deploy time; keys/certs are generated by
# slate/rackpki into slate/pki/ and kept as 1Password Document items.
# ---------------------------------------------------------------------------

# 1Password-mounted env files (named pipes): root passwords at ./.env
# (intel-rack-creds), MQTT broker passwords at slate/.env (rack-mqtt).
# Ignore any .env anywhere. Never read them.
.env
.env.*
!.env.example

# Generic credential files (incl. per-host /etc/rack/<user>.password copies)
*.creds
*.secret
*.secrets
*.password

# --- slate/ (GL.iNet Slate: Mosquitto broker + rackctl) ---------------------
# Real Mosquitto password file (made by `rackpki passwd`); keep passwd.example
slate/mosquitto/passwd
slate/mosquitto/passwd.*
!slate/mosquitto/passwd.example

# --- PKI: CA, broker, and per-client TLS material -------------------------
# slate/pki/ is rackpki OUTPUT only and is ignored entirely. rackpki's source
# is in slate/rackpki/ and is tracked.
# The CA key is the crown jewel: anyone holding it can mint a client cert.
slate/pki/
**/certs/
*.key
*.pem
*.crt
*.csr
*.srl
*.p12
*.pfx

# --- Real component configs (have host paths/identity); keep the examples --
pc-agent/config
pc-agent/config.toml
pc-agent/config.*.toml
!pc-agent/config.example.toml
sbc4/relay-mqtt/config
sbc4/relay-mqtt/config.toml
sbc4/relay-mqtt/config.*.toml
!sbc4/relay-mqtt/config.example.toml

# --- Build output and e2e scratch -------------------------------------------
# Go: <component>/bin/. Rust: <component>/target/. Rust's src/bin/ is source.
**/bin/
!**/src/bin/
**/target/
**/e2e/certs/
**/e2e/tmp/

# Claude Code local state (agent worktrees)
.claude/
